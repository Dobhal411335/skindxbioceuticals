# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/skindxbioceuticals?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated origins for storefront, .com site, and admin (port 3002)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# First-admin bootstrap (Postman only — never expose to frontend).
# Optional: omit in production after the first admin exists; bootstrap stays disabled when unset.
# ADMIN_BOOTSTRAP_SECRET=change-me-bootstrap-secret-min-32-chars

# Brevo transactional email (server-only — never expose to frontend)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=SkinDx Bioc
# BREVO_REPLY_TO=support@example.com

# Company / site branding for transactional emails
COMPANY_NAME=SkinDx Bioc
# COMPANY_LOGO_URL=https://cdn.example.com/logo.png
SUPPORT_EMAIL=support@example.com
SITE_IN_URL=http://localhost:3000
SITE_COM_URL=http://localhost:3001
# PRIVACY_POLICY_URL=https://example.com/privacy

# Optional — reserved for future integrations (do not hard-code secrets in source)
# PAYMENT_GATEWAY_KEY=
# SMS_API_KEY=
# DATABASE_URL_TEST=postgresql://USER:PASSWORD@localhost:5432/skindxbioceuticals_test?schema=public

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth (Web client ID from Google Cloud Console — used to verify ID tokens)
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Refresh-token cookie for storefront/customer sessions
# AUTH_REFRESH_COOKIE_NAME=skindx_refresh_token
# Use AUTH_COOKIE_SAME_SITE=none and AUTH_COOKIE_SECURE=true when the API and storefront are on different sites over HTTPS
# AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_SECURE=false

# Customer email verification OTP (password signup)
# OTP_LENGTH=6
# OTP_EXPIRES_IN_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
