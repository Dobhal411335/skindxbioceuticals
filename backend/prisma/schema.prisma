generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums — foundational domain vocabulary (no seed / fake business data)
// =============================================================================

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum SiteRole {
  VIEWER
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
  COD
  OTHER
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum EnquirySource {
  WEBSITE_IN
  WEBSITE_COM
  ADMIN
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum ShippingStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum AuthProvider {
  GOOGLE
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
}

enum SocialPostType {
  INSTAGRAM
  FACEBOOK
}

enum GalleryMediaType {
  IMAGE
  VIDEO
}

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
}

enum TopAdvertisementSection {
  ANNOUNCEMENT
  UTILITY
  BENEFIT
}

enum HeroBannerLayoutType {
  FULL_WIDTH
  SPLIT_DUAL
  MULTI_IMAGE
}

// =============================================================================
// Multi-site (.in storefront + .com content/enquiry)
// =============================================================================

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  domain    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships            SiteMembership[]
  products               Product[]
  categories             Category[]
  orders                 Order[]
  enquiries              Enquiry[]
  media                  Media[]
  companyBasicInfo       CompanyBasicInfo?
  navbarSections         NavbarSection[]
  socialPosts            SocialPost[]
  galleryItems           GalleryItem[]
  customerReviews        CustomerReview[]
  footerConfig           FooterConfig?
  topAdvertisementConfig TopAdvertisementConfig?
  popupBannerConfig        PopupBannerConfig?
  aboutUsBannerConfig      AboutUsBannerConfig?
  promoBannerConfig        PromoBannerConfig?
  collectionBannerConfig   CollectionBannerConfig?
  faqSections              FaqSection[]
  insightCards             InsightCard[]
  insightQaItems           InsightQa[]
  heroBannerSlides         HeroBannerSlide[]
  catalogColors            CatalogColor[]
  catalogTags              CatalogTag[]
  coupons                  Coupon[]
  blogs                    Blog[]

  @@map("sites")
}

model SiteMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  role      SiteRole @default(VIEWER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
  @@map("site_memberships")
}

// =============================================================================
// Identity & access
// =============================================================================

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String?    @map("password_hash")
  firstName          String?    @map("first_name")
  lastName           String?    @map("last_name")
  phone              String?
  imageUrl           String?    @map("image_url")
  role               UserRole   @default(CUSTOMER)
  status             UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?  @map("email_verified_at")
  welcomeEmailSentAt DateTime?  @map("welcome_email_sent_at")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  addresses               Address[]
  cart                    Cart?
  wishlist                Wishlist?
  orders                  Order[]
  reviews                 Review[]
  refreshTokens           RefreshToken[]
  externalIdentities      ExternalIdentity[]
  emailVerificationTokens EmailVerificationToken[]
  emailOutbox             EmailOutbox[]
  enquiries               Enquiry[]
  siteMemberships         SiteMembership[]
  media                   Media[]

  @@map("users")
}

model ExternalIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("external_identities")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  tokenHash    String              @map("token_hash")
  purpose      VerificationPurpose
  expiresAt    DateTime            @map("expires_at")
  attemptCount Int                 @default(0) @map("attempt_count")
  consumedAt   DateTime?           @map("consumed_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model EmailOutbox {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String?           @map("user_id") @db.Uuid
  templateKey  String            @map("template_key")
  siteCode     String            @map("site_code")
  payloadJson  Json              @map("payload_json")
  status       EmailOutboxStatus @default(PENDING)
  attemptCount Int               @default(0) @map("attempt_count")
  lastError    String?           @map("last_error")
  createdAt    DateTime          @default(now()) @map("created_at")
  sentAt       DateTime?         @map("sent_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("email_outbox")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String   @map("postal_code")
  country    String   @default("IN")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// =============================================================================
// Catalog
// =============================================================================

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  name           String
  slug           String
  description    String?
  parentId       String?  @map("parent_id") @db.Uuid
  /// Banner images belong to subcategories (parentId set); roots keep these null.
  bannerUrl      String?  @map("banner_url")
  bannerPublicId String?  @map("banner_public_id")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  site            Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        Category[]        @relation("CategoryTree")
  products        ProductCategory[]
  catalogProducts Product[]         @relation("ProductSubcategory")

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([siteId, parentId])
  @@index([siteId, isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  siteId            String        @map("site_id") @db.Uuid
  subcategoryId     String?       @map("subcategory_id") @db.Uuid
  productCode       String        @map("product_code")
  name              String
  slug              String
  /// Rich overview HTML used by the Product Description admin section.
  description       String?       @db.Text
  status            ProductStatus @default(DRAFT)
  isFeatured        Boolean       @default(false) @map("is_featured")
  isRecent          Boolean       @default(false) @map("is_recent")
  isBestSeller      Boolean       @default(false) @map("is_best_seller")
  sizeChartUrl      String?       @map("size_chart_url")
  sizeChartPublicId String?       @map("size_chart_public_id")
  /// Logo / banner image for the Product Gallery admin section.
  bannerUrl         String?       @map("banner_url")
  bannerPublicId    String?       @map("banner_public_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  site             Site                     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  subcategory      Category?                @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  categories       ProductCategory[]
  variants         ProductVariant[]
  media            ProductMedia[]
  reviews          Review[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  sizes            ProductSize[]
  colors           ProductColor[]
  galleryImages    ProductGalleryImage[]
  videos           ProductVideo[]
  infoSections     ProductInfoSection[]
  editorialReviews ProductEditorialReview[]
  tags             ProductTag[]
  highlights       ProductHighlight[]
  tax              ProductTax?
  coupon           ProductCoupon?

  @@unique([siteId, slug])
  @@unique([siteId, productCode])
  @@index([siteId])
  @@index([subcategoryId])
  @@index([siteId, status])
  @@index([siteId, status, isFeatured])
  @@index([siteId, status, isRecent])
  @@index([siteId, status, isBestSeller])
  @@map("products")
}

/// Site-scoped color master used by Color Management (hex unique per site).
model CatalogColor {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  name      String
  hex       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  productColors ProductColor[]

  @@unique([siteId, hex])
  @@unique([siteId, name])
  @@index([siteId])
  @@map("catalog_colors")
}

/// Site-scoped tag master for Category Tag section.
model CatalogTag {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  productTags ProductTag[]

  @@unique([siteId, name])
  @@index([siteId])
  @@map("catalog_tags")
}

model ProductSize {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@index([productId, sortOrder])
  @@map("product_sizes")
}

model ProductColor {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  colorId   String?  @map("color_id") @db.Uuid
  /// Custom color name when not linked to CatalogColor.
  name      String
  hex       String?
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   CatalogColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_colors")
}

model ProductGalleryImage {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  imageUrl      String   @map("image_url")
  imagePublicId String   @default("") @map("image_public_id")
  isPrimary     Boolean  @default(false) @map("is_primary")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_gallery_images")
}

model ProductVideo {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  name        String
  url         String
  description String   @default("") @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_videos")
}

model ProductInfoSection {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  title     String
  body      String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_info_sections")
}

/// Admin-curated product reviews (distinct from customer `Review` moderation).
model ProductEditorialReview {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  createdByName String   @map("created_by_name")
  rating        Int
  title         String   @default("")
  body          String   @db.Text
  imageUrl      String?  @map("image_url")
  imagePublicId String?  @map("image_public_id")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_editorial_reviews")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     CatalogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model ProductHighlight {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  text      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_highlights")
}

model ProductTax {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  cgst      Decimal  @db.Decimal(5, 2)
  sgst      Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_taxes")
}

model ProductCoupon {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@map("product_coupons")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id                   String   @id @default(uuid()) @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  /// Optional; not auto-generated for price/quantity offers. Unique when set (PostgreSQL allows multiple NULLs).
  sku                  String?  @unique
  name                 String
  price                Decimal  @db.Decimal(12, 2)
  compareAtPrice       Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  vendorPrice          Decimal? @map("vendor_price") @db.Decimal(12, 2)
  currency             String   @default("INR")
  isActive             Boolean  @default(true) @map("is_active")
  sizeLabel            String?  @map("size_label")
  colorLabel           String?  @map("color_label")
  weightGrams          Int?     @map("weight_grams")
  profileImageUrl      String?  @map("profile_image_url")
  profileImagePublicId String?  @map("profile_image_public_id")
  /// Extra gallery images for this offer row: [{ url, publicId }]
  subImages            Json?    @map("sub_images")
  attributes           Json?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     InventoryItem?
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  // Enables composite FKs so cart/order rows cannot point at a mismatched product+variant
  @@unique([id, productId])
  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

// =============================================================================
// Inventory
// =============================================================================

model InventoryItem {
  id                String   @id @default(uuid()) @db.Uuid
  variantId         String   @unique @map("variant_id") @db.Uuid
  quantityOnHand    Int      @default(0) @map("quantity_on_hand")
  quantityReserved  Int      @default(0) @map("quantity_reserved")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@map("inventory_items")
}

model InventoryMovement {
  id              String                @id @default(uuid()) @db.Uuid
  inventoryItemId String                @map("inventory_item_id") @db.Uuid
  type            InventoryMovementType
  quantity        Int
  note            String?
  referenceType   String?               @map("reference_type")
  referenceId     String?               @map("reference_id")
  createdAt       DateTime              @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@map("inventory_movements")
}

// =============================================================================
// Cart & wishlist
// =============================================================================

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Composite FK guarantees variant.productId matches cart_items.product_id
  variant ProductVariant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Product-level uniqueness avoids Postgres NULL-duplicate holes in (wishlist, product, variant)
  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// =============================================================================
// Orders, payments, shipping, coupons
// =============================================================================

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  siteId          String      @map("site_id") @db.Uuid
  orderNumber     String      @unique @map("order_number")
  userId          String      @map("user_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  currency        String      @default("INR")
  subtotal        Decimal     @db.Decimal(12, 2)
  discountTotal   Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal   Decimal     @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal        Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal      Decimal     @map("grand_total") @db.Decimal(12, 2)
  couponId        String?     @map("coupon_id") @db.Uuid
